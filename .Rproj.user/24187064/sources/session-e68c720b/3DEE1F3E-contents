#figura 4.9 - Probabilidade dos tópicos por fase estilística encontrada
lda_2fases <- letras|>
  mutate(fase_estilistica = ifelse(indice < 98, 
                                   "Fase Clássica", "Fase Experimental"))

duasfases_dtm <- lda_2fases|>
  select(song, lyrics, fase_estilistica)|>
  unnest_tokens(input = lyrics, output = word)|>
  anti_join(stop_words)|>
  group_by(song, fase_estilistica)|>
  dplyr::count(word)|>
  unite(document, song, fase_estilistica)|>
  cast_dtm(document = document, term = word, value = n)

topicos_lda2 <- LDA(duasfases_dtm, k = 5, control = list(seed = 1742))

probs_docs2 <- tidy(topicos_lda2, matrix = "gamma")

p17 <- probs_docs2|>
  separate(document, c("title", "fase"), sep = "_")|>
  mutate(period = reorder(fase, gamma * topic),
         topic = as.factor(topic))|>
  ggplot(aes(x = topic, y = gamma))+
  geom_boxplot(show.legend = FALSE,
               outliers = FALSE,
               color = "#56B4E9")+
  geom_quasirandom(color = "#56B4E9", 
                   width = 0.4, alpha = 0.5, size = 1, show.legend = FALSE)+
  labs(title = "Figura 4.9 - Probabilidade dos tópicos por fase estilística encontrada",
    x = "Tópico", y = "P(tópico|documento)")+
  facet_wrap(~ period)+
  scale_color_manual(values = brewer.pal(n = 6, name = "Blues")[2:6])+
  theme_bw()+
  theme(plot.title = element_text(color = "grey40", size = 15),
        plot.subtitle = element_text(color = "grey40", size = 12),
        strip.text = element_text(color = "grey40", size = 12, hjust = 0),
