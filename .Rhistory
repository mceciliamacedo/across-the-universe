geom_line(linewidth = 0.8, color = "grey70")+
geom_point(size = 2, color = "deepskyblue4")+
geom_text(aes(label = Album), hjust = 0, nudge_y = 0.03, size = 3, color = "grey20")+
geom_hline(yintercept = 0.5, linetype = "dashed", color = "darkred", alpha = 0.5)+
labs(#title = "proporção do perfil convencional por álbum (GMM k = 2)",
#subtitle = "a linha tracejada marca 50%",
x = "álbum (ordem cronológica)", y = "proporção convencional")+
