labs(title = "incerteza de pertencimento por fase (GMM)",
subtitle = "escala logarítmica",
x = NULL, y = "incerteza (1 - prob. máxima)")+
theme_minimal()+
theme(plot.title = element_text(color = "grey40", size = 15),
plot.subtitle = element_text(color = "grey40", size = 12),
legend.position = "none",
axis.title = element_text(color = "grey40", hjust = 1, size = 12),
axis.text.x = element_text(color = "grey40", size = 11),
axis.text.y = element_text(color = "grey40", size = 10),
axis.ticks = element_blank())
probs_post|>
filter(Period == "early")|>
select(incerteza)|>
summary()
probs_post|>
filter(Period == "middle")|>
select(incerteza)|>
summary()
probs_post|>
filter(Period == "late")|>
select(incerteza)|>
summary()
proporcoes <- musicas|>
mutate(Album = factor(Album, levels = ordem_albuns))|>
dplyr::count(Album, cluster_gmm)|>
group_by(Album)|>
mutate(prop = n/sum(n))|>
ungroup()|>
filter(cluster_gmm == "Clássico")|>
mutate(idx = row_number())
#proporções por album
musicas|>
mutate(Album = factor(Album, levels = ordem_albuns))|>
dplyr::count(Album, cluster_gmm)|>
pivot_wider(names_from = cluster_gmm, values_from = n, values_fill = 0)|>
mutate(prop_convencional = Clássico / (Experimental + Clássico))
