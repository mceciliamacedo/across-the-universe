  scale_linewidth_manual(values = c("0" = 0.7, "1" = 1.2))+
  scale_x_continuous(breaks = 1:6)+
  theme_classic()+
  theme(plot.title = element_text(color = "grey40", size = 15),
        legend.position = c(.97,.95),
        legend.justification = c("right", "top"),
