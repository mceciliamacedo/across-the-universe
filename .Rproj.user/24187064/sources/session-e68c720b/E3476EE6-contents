#--- LDA
{
#document-term matrix - linhas: documentos; colunas: palavras; valores preenchidos: nº de vezes que uma palavra aparece em um documento
matriz_dtm <- palavras|>
  group_by(song, Period)|>
  count(word)|>
  unite(document, song, Period)|>
  cast_dtm(document = document, term = word, value = n)

#modelo
topicos <- LDA(matriz_dtm, k = 5, control = list(seed = 1742)) #1742

#probabilidades por tópico por palavra
probs_palavras <- tidy(topicos, matrix = "beta") #P(palavra|topico)
probs_documentos <- tidy(topicos, matrix = "gamma") #P(topico|documento)

#probabilidade de uma palavra em um tópico
probs_palavras|>
  group_by(topic)|>
  slice_max(order_by = beta, n = 10)|>
  ungroup()|> 
  mutate(nome_topicos = case_when(topic == 1 ~ "Tópico 1",
                                  topic == 2 ~ "Tópico 2",
                                  topic == 3 ~ "Tópico 3",
                                  topic == 4 ~ "Tópico 4",
                                  topic == 5 ~ "Tópico 5"))|>
  ggplot(aes(x = beta, y = reorder_within(term, beta, topic), 
             fill = factor(topic)))+
  geom_col(show.legend = FALSE)+
  labs(#title = "termos mais prováveis em cada tópico",
       #subtitle = "latent dirichlet allocation (LDA)",
       x = "P(palavra|tópico)", y = NULL)+
  facet_wrap(~ nome_topicos, scales = "free")+
  scale_x_continuous(labels = scales::number_format(accuracy = 0.01))+
  scale_y_reordered()+
  scale_fill_manual(values = brewer.pal(n = 6, name = "Blues")[2:6])+
  theme_minimal()+
  theme(plot.title = element_text(color = "grey40", size = 15),
        plot.subtitle = element_text(color = "grey40", size = 12),
        strip.text = element_text(color = "grey40", size = 12, hjust = 0),
        axis.title = element_text(color = "grey40", size = 11, hjust = 0.066),
        axis.text = element_text(color = "grey40", size = 10),
        axis.ticks = element_blank())

#probabilidade de um tópico em um documento
prob_topico <- probs_documentos|>
  separate(document, c("title", "period"), sep = "_")|>
  mutate(period = reorder(period, gamma * topic),
         topic = as.factor(topic))|>
  mutate(period = case_when(period == "early" ~ "Inicial",
                            period == "middle" ~ "Intermediário",
                            period == "late" ~ "Final"))|>
  mutate(period = factor(period, 
                         levels = c("Inicial", "Intermediário", "Final")))|>
  ggplot(aes(x = topic, y = gamma, color = topic))+
  geom_boxplot(show.legend = FALSE,
               outliers = FALSE)+
  geom_quasirandom(aes(color = topic), 
                   width = 0.4, alpha = 0.5, size = 1, show.legend = FALSE)+
  labs(#title = "probabilidade dos tópicos",
       #subtitle = "em cada documento",
       x = "Tópico", y = "P(tópico|documento)")+
  facet_wrap(~ period)+
  scale_color_manual(values = brewer.pal(n = 6, name = "Blues")[2:6])+
  theme_bw()+
