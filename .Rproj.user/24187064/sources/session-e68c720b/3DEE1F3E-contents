  mutate(Album = factor(Album, levels = ordem_albuns))|>
  dplyr::count(Album, cluster_gmm)|>
  group_by(Album)|>
  mutate(prop = n/sum(n))|>
  ungroup()|>
  filter(cluster_gmm == "Clássico")|>
  mutate(idx = row_number())

