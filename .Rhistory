color = "tomato4", linewidth = 0.7, linetype = "dashed")+
annotate("segment", x = change2[5], y = -9, yend = par_change2[5],
color = "tomato4", linewidth = 0.7, linetype = "dashed")+
annotate("text", label = musicas_change2[1], x = change2[1] - 2, y = -4,
color = "tomato4", hjust = "right", vjust = "bottom")+
annotate("text", label = musicas_change2[2], x = change2[2] - 2, y = 3.5,
color = "tomato4", hjust = "right", vjust = "top")+
annotate("text", label = musicas_change2[3], x = change2[3] - 2, y = -8.5,
color = "tomato4", fontface = "bold", hjust = "right", vjust = "bottom")+
annotate("text", label = musicas_change2[4], x = change2[4] + 2, y = 3.3,
color = "tomato4", hjust = "left", vjust = "top")+
annotate("text", label = musicas_change2[5], x = change2[5] + 2, y = -9,
color = "tomato4", fontface = "bold", hjust = "left", vjust = "bottom")+
theme_classic()+
theme(plot.title = element_text(color = "grey40", size = 15),
plot.subtitle = element_text(color = "grey40", size = 12),
axis.title = element_text(color = "grey40", size = 12, hjust = 1),
axis.text = element_text(color = "grey40", size = 10),
axis.ticks = element_blank(),
axis.line = element_line(color = "grey40"))
#considerando helter skelter e revolution 9 como outliers
