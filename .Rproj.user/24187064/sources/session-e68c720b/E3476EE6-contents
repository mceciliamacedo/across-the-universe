{
set.seed(42)  

Y <- musicas|>
  select(all_of(vars_acusticas))|>
  as.matrix()

#--- MANOVA - pressupostos

#normalidade multivariada - violado
musicas|>
  select(all_of(vars_acusticas))|>
  t()|>
  as.matrix()|>
  mshapiro.test() #os dados não seguem uma distribuição normal multivariada

#homogeneidade das matrizes de covariância - violado
periodo <- factor(musicas$Period)

musicas|>
  select(all_of(vars_acusticas))|>
  boxM(group = periodo) #não há homogeneidade nas matrizes de covariâncias

#como a manova se mostrou ineficiente para testar a significancia da divisão das canções dos beatles em períodos, a permanova surge com uma alternativa não paramétrica. a partir dela é possivel identificar se existe separação devido a variabilidade dos grupos.

#--- PERMANOVA
permanova <- adonis2(Y ~ Period, data = musicas, method = "euclidian", permutations = 999)

#o teste foi significativo. portanto, há evidências que contrubuem acerca da existência de uma divisão da discografia dos beatles em períodos. mas o teste não nos diz onde essa diferença ocorre. todas as fases são diferentes entre si? existes fases que não diferem entre si? para responder isso, será realizado o teste novamente, mas comparando par a par. porém é preciso cuidado ao realizar esses teste, visto que se utililizar 5% como nível de significância a probabilidade de um erro tipo I é de 14,26%, para que isso seja corrigido, é necessário fazer uma correção no nivel de significancia, portanto a partir de agora o nivel considerado será α = 1.7% (= 0.017).

#early x middle
idx_em <- musicas$Period %in% c("early", "middle")
adonis2(Y[idx_em,] ~ Period, data = musicas[idx_em,],
          method = "euclidian", permutations = 999)
#a 0,017 de significancia, a diferença entre os periodos early e middle é significativa.

#early x late
idx_el <- musicas$Period %in% c("early", "late")
adonis2(Y[idx_el,] ~ Period, data = musicas[idx_el,],
        method = "euclidian", permutations = 999)
#a 0,017 de significancia, a diferença entre os periodos early e late é significativa.

#middle x late
idx_ml <- musicas$Period %in% c("middle", "late")
adonis2(Y[idx_ml,] ~ Period, data = musicas[idx_ml,],
        method = "euclidian", permutations = 999)
#a 0,017 de significancia, a diferença entre os periodos middle e late NÃO é significativa.

#o período inicial difere dos demais, porém os períodos intermediário e final não possuem diferença significativa, portanto há indicios de que talvez a melhor divisão em períodos a ser usada é em dois períodos, e não a usual de tres  fases.


#agora vamos testar a diferença geral entre a fase inicial e as musicas que foram lançadas após ela.
musicas <- musicas|>
  mutate(Period2 = ifelse(Period == "early", "early", "post1965"))

adonis2(Y ~ Period, data = musicas, method = "euclidian", permutations = 999)
adonis2(Y ~ Period2, data = musicas, method = "euclidian", permutations = 999) #explica um pouco menos, porém é mais simples.

#--- verificando com diferentes distâncias
#os resultados obtidos foram levando em conta a distância mais comum, a euclidiana. mas eles se mantêm se trocarmos o método do calculo de distâncias? se os resultados nao se alterarem, podemos concluir que eles são consistentes.

adonis2(Y ~ Period, data = musicas, method = "euclidian", permutations = 999)
adonis2(Y ~ Period, data = musicas, method = "manhattan", permutations = 999)
adonis2(Y ~ Period, data = musicas, method = "gower", permutations = 999)

#par a par
adonis2(Y[idx_em,] ~ Period, data = musicas[idx_em,], 
        method = "manhattan", permutations = 999)
adonis2(Y[idx_em,] ~ Period, data = musicas[idx_em,], 
