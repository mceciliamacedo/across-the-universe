vars_musicas <- names(musicas)
musicas_ordem <- musicas|>
inner_join(
dplyr::select(letras, titulo_tratado, indice), by = "titulo_tratado")|>
select(all_of(vars_musicas), indice)|>
arrange(indice)
titulos_ordem <- musicas_ordem|>
pull(titulo_tratado)
scores_ordenados <- pca$x[match(titulos_ordem, musicas$titulo_tratado),]
df_scores <- musicas_ordem|>
select(indice, Title)|>
mutate(pc1 = scores_ordenados[,"PC1"],
pc2 = scores_ordenados[,"PC2"],
pc3 = scores_ordenados[,"PC3"])
#changepoint - componete 1
change_pc1 <- cpt.mean(scores_ordenados[,"PC1"],
method = "PELT", penalty = "MBIC")
change1 <- cpts(change_pc1)
par_change1 <- change_pc1@param.est[[1]] #parametro da mudança
musicas_change1 <- musicas_ordem$Title[change1]
cgp1 <-  ggplot(df_scores, aes(x = indice, y = pc1))+
geom_line(linewidth = 0.4)+
labs(#title = "changepoints — PC1",
#subtitle = "ordenado pelas músicas",
x = "Músicas (índice cronológico)",
y = "PC1 - empolgação sonora")+
annotate("segment", x = 0, xend = change1, y = par_change1[1],
color = "grey30", linewidth = 0.7, alpha = 0.7)+
annotate("segment", x = change1, xend = 184, y = par_change1[2],
color = "grey30", linewidth = 0.7, alpha = 0.7)+
annotate("segment", x = change1, y = -4, yend = 3,
color = "darkred", linetype = "dashed", linewidth = 0.7)+
annotate("text", label = musicas_change1, x = change1 - 1, y = -3.9,
color = "darkred", fontface = "bold", hjust = "right")+
theme_classic()+
theme(plot.title = element_text(color = "grey40", size = 15),
plot.subtitle = element_text(color = "grey40", size = 12),
axis.title = element_text(color = "grey40", size = 12, hjust = 1),
