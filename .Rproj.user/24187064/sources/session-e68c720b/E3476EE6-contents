#--- RIQUEZA LEXICAL
{
#ttr = palavras únicas / total de palavras - mede o quão variado o vocabulário de um texto é

#msttr: ttr calculado em pedaços
msttr <- function(words, seg_size = 50){
n <- length(words)
n_segs <- floor(n/seg_size)

if(n_segs == 0){
  return(NA)
}

segs <- split(words[1:(seg_size*n_segs)],
              rep(1:n_segs, each = seg_size))

mean(sapply(segs, FUN = function(s){n_distinct(s)/length(s)}))
}

#entropia de shannon - NÃO ENTENDI
entropia_shannon <- function(words){
freq <- table(words)
pi <- freq/sum(freq)
-sum(pi * log2(pi))
}

#calculando métricas
riqueza <- letras|>
unnest_tokens(input = lyrics, output = word)|>
group_by(song, Period, Album)|>
summarise(tokens = n(),
          ttr = n_distinct(word)/n(),
          msttr = msttr(word, seg_size = 40),
          entropia = entropia_shannon(word),
          .groups = "drop")

riqueza|>
print(n = Inf)

#medias por período
riqueza|>
mutate(Period = factor(Period, levels = c("early", "middle", "late")))|>
group_by(Period)|>
summarise(media_ttr = mean(ttr),
          media_msttr = mean(msttr, na.rm = TRUE),
          media_entropia = mean(entropia),
          sd_entropia = sd(entropia))

#correlação com o tamanho do texto
cor.test(riqueza$tokens, riqueza$ttr, method = "spearman")
cor.test(riqueza$tokens, riqueza$msttr, method = "spearman")
cor.test(riqueza$tokens, riqueza$entropia, method = "spearman")
#aqui é possivel ver que a única métrica que não é afetada pelo tamanho do texto é o msttr. 

