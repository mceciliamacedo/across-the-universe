embaixo <- c("Please Please Me", "Beatles For Sale", "Revolver", "The Beatles",
"Abbey Road")
df_embaixo <- proporcoes|>
filter(Album %in% embaixo)
df_emcima <- proporcoes|>
filter(!Album %in% embaixo & Album != "Yellow Submarine" & Album != "With The Beatles")
df_esquerda <- proporcoes|>
filter(Album == "With The Beatles")
df_ys <- proporcoes|>
filter(Album == "Yellow Submarine")
ggplot()+
geom_hline(yintercept = 0.5, linetype = "dashed",
color = "darkred", alpha = 0.5)+
geom_line(data = proporcoes, mapping = aes(x = idx, y = prop),
linewidth = 0.8, color = "grey70")+
geom_point(data = proporcoes, mapping = aes(x = idx, y = prop),
size = 2, color = "deepskyblue4")+
geom_text(data = df_embaixo, aes(x = idx, y = prop, label = Album),
hjust = 0.2, nudge_y = -0.04, size = 3, color = "grey20")+
geom_text(data = df_emcima, aes(x = idx, y = prop, label = Album),
hjust = 0, nudge_y = 0.04, size = 3, color = "grey20")+
geom_text(data = df_esquerda, aes(x = idx, y = prop, label = Album),
hjust = 1, nudge_y = 0.04, size = 3, color = "grey20")+
geom_text(data = df_ys, aes(x = idx, y = prop, label = Album),
nudge_y = 0.04, size = 3, color = "grey20")+
labs(x = "Álbum", y = "Proporção do perfil clássico")+
scale_x_continuous(breaks = 1:13, limits = c(0.5,14))+
scale_y_continuous(labels = scales::percent, limits = c(0,1.05))+
annotate("text", label = "Fase Experimental", x = 2.5, y = 0.125,
fontface = "bold", size = 6, alpha = 0.28)+
annotate("text", label = "Fase Clássica", x = 13, y = 0.95,
fontface = "bold", size = 6, alpha = 0.28)+
theme_classic()+
theme(plot.title = element_text(color = "grey40", size = 15),
axis.title = element_text(color = "grey40", size = 11, hjust = 1),
axis.text.x = element_blank(),
axis.text.y = element_text(color = "grey40", size = 10),
axis.ticks = element_blank(),
axis.line = element_line(color = "grey40"))
