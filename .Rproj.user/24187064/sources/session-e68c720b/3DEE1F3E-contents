#figura 4.2 - Seleção do número de componentes via BIC
library(mclust)

dados_gmm <- musicas|> 
  select(all_of(vars_acusticas))|>
  scale()

gmm_bic <- mclustBIC(dados_gmm, G = 1:6)

bic_mat <- unclass(gmm_bic)
attr(bic_mat, "criterion") <- NULL

modelos <- as.data.frame(bic_mat)|> 
  mutate(G = as.integer(rownames(bic_mat)))|>
  pivot_longer(cols = -G, names_to = "modelo", values_to = "BIC")|>
  mutate(melhor_modelo = ifelse(modelo %in% c("VVV", "VVE", "VVI"), "1", "0"))

melhores_modelos <- modelos|>
  filter(melhor_modelo == "1")

outros_modelos <- modelos|>
  filter(melhor_modelo != "1")

p10 <- ggplot()+
  geom_line(data = outros_modelos, mapping = aes(x = G, y = BIC, group = modelo),
            linewidth = 0.3, color = "grey40", alpha = 0.5)+
  geom_line(data = melhores_modelos, mapping = aes(x = G, y = BIC, color = modelo),
            linewidth = 1.1, alpha = 0.8)+
  labs(title = "Figura 4.2 - Seleção do número de componentes via BIC",
       x = "nº de componentes", y = "BIC", 
       color = "Modelo", linewidth = NULL)+
  scale_color_okabe_ito(order = c(3, 5, 6),
                        labels = c("early" = "Inicial", "middle" = "Intermediário",
